  "components": {
    "schemas": {
      "AccessRequest": {
        "properties": {
          "roles": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Roles"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "roles"
        ],
        "title": "AccessRequest"
      },
      "AppGrant": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "appId": {
            "type": "string",
            "format": "uuid",
            "title": "Appid"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "appId",
          "roles",
          "enabled",
          "version"
        ],
        "title": "AppGrant"
      },
      "AppPermissions": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "appId": {
            "type": "string",
            "format": "uuid",
            "title": "Appid"
          },
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "authorizationVersion": {
            "type": "integer",
            "title": "Authorizationversion"
          },
          "evaluatedAt": {
            "type": "string",
            "title": "Evaluatedat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userId",
          "appId",
          "allowed",
          "roles",
          "authorizationVersion",
          "evaluatedAt"
        ],
        "title": "AppPermissions"
      },
      "CurrentUser": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user"
        ],
        "title": "CurrentUser"
      },
      "Decision": {
        "properties": {
          "decision": {
            "type": "string",
            "pattern": "^(approved|rejected)$",
            "title": "Decision"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "comment"
        ],
        "title": "Decision"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorResponse"
      },
      "Grant": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "roles": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Roles"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userId",
          "roles",
          "enabled"
        ],
        "title": "Grant"
      },
      "GrantPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ListedGrant"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "GrantPage"
      },
      "ListedGrant": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "appId": {
            "type": "string",
            "format": "uuid",
            "title": "Appid"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "displayName": {
            "type": "string",
            "title": "Displayname"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "appId",
          "roles",
          "enabled",
          "version",
          "displayName",
          "email"
        ],
        "title": "ListedGrant"
      },
      "OwnRequestPage": {
