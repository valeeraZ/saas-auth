{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "enum": [
        "organization.created",
        "organization.suspended",
        "organization.reactivated",
        "organization.deletion_requested",
        "organization.deleted"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "authorizationVersion": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "active",
            "suspended",
            "deleting",
            "deleted"
          ]
        }
      },
      "required": [
        "status"
      ]
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "type",
    "occurredAt",
    "organizationId",
    "sequence",
    "authorizationVersion",
    "data"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/auth/organization-lifecycle/v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "organization.created"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "organization.suspended"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "suspended"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "organization.reactivated"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "organization.deletion_requested"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "deleting"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "organization.deleted"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "status": {
                "const": "deleted"
              }
            }
          }
        }
      }
    }
  ]
}
