{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "tenant.authorization_changed"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "authorizationVersion": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "active",
            "suspended",
            "deleting",
            "deleted"
          ]
        }
      },
      "required": [
        "status"
      ]
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "type",
    "occurredAt",
    "tenantId",
    "sequence",
    "authorizationVersion",
    "data"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/auth/authorization-changed/v1"
}
